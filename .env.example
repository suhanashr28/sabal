# Server-only settings. Set in Vercel; never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@TRANSACTION_POOLER_HOST:6543/postgres?sslmode=require
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=YOUR_SUPABASE_REGION
S3_ACCESS_KEY_ID=YOUR_SERVER_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_SERVER_S3_SECRET_KEY
S3_BUCKET=loveflix
# Optional custom domain only; Vercel-assigned hostnames are detected automatically.
# PUBLIC_ORIGIN=https://your-domain.example
